# Maintainer: Spider19996 <spider19996@users.noreply.github.com>
pkgname=g733-tray
pkgver=1.1.0
pkgrel=1
pkgdesc='Tray application for the Logitech G733 (battery level, light) for KDE Plasma'
arch=('any')
url='https://github.com/Spider19996/HeadsetControl-G733-Tray'
license=('MIT')
depends=('python' 'python-pyqt6')
makedepends=('python-build' 'python-installer' 'python-setuptools')
optdepends=('headsetcontrol: required at runtime (4.2.0 or newer)'
            'libnotify: notify-send for notifications with urgency')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP')  # replace with updpkgsums after the first release

build() {
    cd "HeadsetControl-G733-Tray-$pkgver"
    python -m build --wheel --no-isolation
}

package() {
    cd "HeadsetControl-G733-Tray-$pkgver"
    python -m installer --destdir="$pkgdir" dist/*.whl
    install -Dm644 packaging/g733-tray.desktop "$pkgdir/usr/share/applications/g733-tray.desktop"
    install -Dm644 udev/70-g733-tray.rules "$pkgdir/usr/lib/udev/rules.d/70-g733-tray.rules"
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
